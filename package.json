{
  "name": "pi-hubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run --exclude=test/integration/**",
    "test:integration": "vitest run test/integration/pi-hubble.integration.test.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "sync:skills": "node ./scripts/sync-hubble-skills.ts",
    "check:skills": "node ./scripts/sync-hubble-skills.ts --check"
  },
  "pi": {
    "extensions": [
      "./extensions/hubble.ts"
    ],
    "skills": [
      "./skills/create-html-app"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^26.2.0",
    "typebox": "^1.3.11",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "better-result": "3.0.0"
  }
}
