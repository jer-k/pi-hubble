{
  "name": "pi-hubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^24.12.4",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.83.0"
  }
}
