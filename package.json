{
  "name": "pi-hubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run --exclude=test/integration/**",
    "test:integration": "vitest run test/integration/pi-hubble.integration.test.ts",
    "bench:writes": "node ./scripts/benchmark-writes.ts",
    "bench:tools": "node ./scripts/benchmark-tools.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format && npm run lint",
    "sync:skills": "node ./scripts/sync-hubble-skills.ts",
    "check:skills": "node ./scripts/sync-hubble-skills.ts --check"
  },
  "pi": {
    "extensions": [
      "./extensions/hubble.ts"
    ],
    "skills": [
      "./skills/create-html-app"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.4",
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typebox": "^1.3.26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-result": "3.0.1"
  }
}
